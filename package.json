{
  "name": "4all-vyberka",
  "version": "1.0.0",
  "private": true,
  "description": "Denní agent a přehled výběrových řízení relevantních pro 4ALL.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "agent": "node src/run.mjs",
    "agent:fixtures": "node src/run.mjs --fixtures",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build"
  }
}
